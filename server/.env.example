# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret (Ensure minimum 32 random characters in production)
JWT_SECRET=super_secret_jwt_key_for_development_replace_in_production_min_32_chars

# Database Connection URL
# Default: SQLite for zero-friction local testing and automated test execution
DATABASE_URL="file:./dev.db"

# Production Option: PostgreSQL
# DATABASE_URL="postgresql://username:password@localhost:5432/lead_manager?schema=public"
